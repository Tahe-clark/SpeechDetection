{
  "version": 2,
  "builds": [
    {
      "src": "backend.py",
      "use": "@vercel/python@latest",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend.py"
    }
  ],
  "functions": {
    "backend.py": {
      "runtime": "python3.9"
    }
  }
}
